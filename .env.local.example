# Copy to .env.local (gitignored) and restart `pnpm dev`.
# Next.js reads env at dev-server startup — shell `export` in another terminal
# or after the server is already running does NOT apply.

# Optional: self-hosted Ollama for interview-quality narrative Profile Q&A.
# Requires: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Text chat model for /api/cv/qa (default: qwen2.5:7b).
# Do NOT use vision models (e.g. qwen3-vl, llava) — this endpoint is text-only and will hang or run very slowly.
OLLAMA_MODEL=qwen2.5:7b

# Optional: Ollama request timeout in ms (default: 120000).
OLLAMA_TIMEOUT_MS=120000

# Optional: log Ollama prompt size to the dev server console.
# OLLAMA_DEBUG=1
