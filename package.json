{
  "name": "devprofile",
  "author": {
    "name": "Peramanathan Sathyamoorthy",
    "email": "sathyam.peram@gmail.com"
  },
  "version": "0.1.0",
  "private": true,
  "files": [
    "_worker.js",
    ".open-next/"
  ],
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run generate-pdf && node scripts/build-qa-index.mjs && node scripts/generate-sw-version.mjs && next build",
    "start": "next start",
    "lint": "biome check . --diagnostic-level=error",
    "lint:report": "biome check . --max-diagnostics=none",
    "lint:fix": "biome check --write . --diagnostic-level=error",
    "format": "biome format --write .",
    "generate-pdf": "bun scripts/generate-pdf.tsx",
    "type-check": "tsc --noEmit",
    "editor:sync": "node scripts/sync-editor-profile.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "node scripts/playwright-ui-brave.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "parse-golden-qa": "node scripts/parse-golden-qa.mjs",
    "build-qa-index": "node scripts/build-qa-index.mjs",
    "qa:eval": "node scripts/qa-eval.mjs",
    "qa:pipeline": "node scripts/parse-golden-qa.mjs && node scripts/build-qa-index.mjs && node scripts/qa-eval.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vercel/toolbar": "^0.2.6",
    "ai": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flags": "^4.0.6",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pdf": "^10.4.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@vercel/speed-insights"
  ],
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
