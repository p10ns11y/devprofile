{
  "name": "devprofile",
  "author": {
    "name": "Peramanathan Sathyamoorthy",
    "email": "sathyam.peram@gmail.com"
  },
  "version": "0.1.0",
  "private": true,
  "files": [
    "_worker.js",
    ".open-next/"
  ],
  "scripts": {
    "dev": "node scripts/sync-github-dashboard-cache.mjs && next dev --turbopack",
    "build": "npm run generate-pdf && node scripts/build-qa-index.mjs && node scripts/generate-sw-version.mjs && node scripts/sync-github-dashboard-cache.mjs && next build",
    "start": "next start",
    "lint": "biome lint . --diagnostic-level=error",
    "lint:report": "biome lint . --max-diagnostics=none",
    "lint:fix": "biome lint --write . --diagnostic-level=error",
    "format": "biome format --write .",
    "imports:fix": "biome check --write --only=organizeImports src scripts tests playwright.config.ts playwright.brave.ts vitest.config.ts next.config.mjs",
    "test:certificates": "vitest run src/lib/certificates src/app/api/certificates",
    "precommit": "pnpm imports:fix && pnpm format && pnpm lint:fix && pnpm lint",
    "generate-pdf": "bun scripts/generate-pdf.tsx",
    "link-application-packs": "node scripts/link-application-packs.mjs",
    "generate-apply-cv": "bun scripts/generate-apply-cv.tsx",
    "type-check": "tsc --noEmit",
    "editor:sync": "node scripts/sync-editor-profile.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "node scripts/playwright-ui-brave.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "verify:doctor": "node scripts/verify-devprofile-doctor.mjs",
    "test:e2e:ux": "playwright test tests/e2e/a11y tests/e2e/content --project=brave-beta --project=brave-beta-mobile",
    "test:e2e:visual": "E2E_VISUAL=1 playwright test --project=brave-beta-visual",
    "parse-golden-qa": "node scripts/parse-golden-qa.mjs",
    "build-qa-index": "node scripts/build-qa-index.mjs",
    "qa:eval": "node scripts/qa-eval.mjs",
    "qa:pipeline": "node scripts/parse-golden-qa.mjs && node scripts/build-qa-index.mjs && node scripts/qa-eval.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:cov": "vitest run --coverage",
    "test:qa": "vitest run src/lib/qa src/app/api/cv/qa",
    "test:golden": "QA_EVAL_STRICT=1 pnpm qa:pipeline",
    "validate-certificates": "node scripts/validate-certificates.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/xai": "^3.0.92",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vercel/toolbar": "^0.2.6",
    "ai": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.17.2",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pdf": "^10.4.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "@vercel/speed-insights"
  ],
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f"
}
